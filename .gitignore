########################
# Python / Packaging   #
########################

# Bytecode / caches
__pycache__/
*.py[cod]
*.pyo
*$py.class
.pytest_cache/
.pytest-mpl-cache/
.ruff_cache/

# Build / dist artifacts
build/
dist/
downloads/
wheels/
sdist/
eggs/
.eggs/
develop-eggs/
parts/
var/
lib/
lib64/
*.egg-info/
*.egg
.installed.cfg

########################
# Virtual Environments #
########################

.venv/
venv/
env/
ENV/
.env/

########################
# Test / Coverage      #
########################

.coverage
htmlcov/

########################
# Editors / IDE        #
########################

# VS Code – keep launch.json in git, ignore local settings/snippets
.vscode/settings.json
.vscode/*.code-snippets

# If you want to keep .vscode entirely local, uncomment the next line:
# .vscode/

# Workspace files are usually per-user
*.code-workspace

# Other editors
.idea/
*.swp
*.swo

########################
# OS / Tools           #
########################

# macOS
.DS_Store
*/.DS_Store

# Claude configuration
.claude/

########################
# Logs / Scratch / Data#
########################

logs/
*.log
scratch/
notes/
data/

# Zip / archive files and dirs (history lives in git)
*.zip
*.tar
*.tar.gz
archive/
_archive/
**/__archive/
**/_archive/
**/archive/

########################
# Project-specific     #
########################

# Executables / objects
*.o
*.obj
image16

# Acquisition log patterns
acquisition_*.log
run.log